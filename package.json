{
  "name": "mench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "npm run dev -w @mench/web",
    "dev:api": "npm run dev -w @mench/api",
    "dev:mobile": "npm run start -w @mench/mobile",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --exclude \"tests/e2e/**\"",
    "build": "npm run build --workspaces --if-present",
    "build:mobile": "EXPO_NO_TELEMETRY=1 npm run export -w @mench/mobile",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
